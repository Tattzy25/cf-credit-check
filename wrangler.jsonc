{
  "name": "credit-check",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "credit-check.tattty.com",
      "zone_name": "tattty.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB_BINDING",
      "database_id": "00a00a6a-a859-4e09-9655-44e5d1307b60"
    }
  ]
}
